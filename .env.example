# Copy to .env and fill in values for local/prod.

# Django
# DJANGO_SECRET_KEY=change-me-in-production
# SECRET_KEY=change-me-in-production
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080

# Docker / Coolify (see docker-compose.yaml)
# SQLITE_PATH=/data/django-apps/opentd/db.sqlite3
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=

# Public site (used in emails / absolute links)
SITE_NAME=OpenTD
SITE_DOMAIN=localhost:8000
# PUBLIC_BASE_URL=http://localhost:8000

# Resend (https://resend.com) — when set, outbound mail uses Resend.
# Without this key, Django prints mail to the console (local dev).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=OpenTD <onboarding@resend.dev>
